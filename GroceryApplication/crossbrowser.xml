<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CrossBrowser">

  <test thread-count="5" name="chromeTest">
  <parameter name="browsers" value="Chrome"></parameter>
    <classes>
      <class name="testScript.LoginTest">      
	  <methods>
      <include name="validCredentials"></include> 
      <include name="invalidCredentials"></include>
      <include name="invalidusernameCredentials"></include>
      </methods>   
      </class>
    </classes>
  </test> <!-- Test -->
  
   <test thread-count="5" name="firefoxTest">
   <parameter name="browsers" value="Chrome"></parameter>
    <classes>
      <class name="testScript.LoginTest">   
       
	  <methods>
      <include name="validCredentials"></include> 
      <include name="invalidCredentials"></include>
      <include name="invalidusernameCredentials"></include>
      </methods>
      
      </class>
    </classes>
  </test> 
  
</suite> <!-- Suite -->
